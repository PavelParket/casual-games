# ============================================================
# casual-games — Environment Variables
# Скопируй в prod.env и заполни секреты (никогда не коммить prod.env!)
# ============================================================

# ─────────────────────────────────────────────────────────────
# JWT (единый секрет для всех сервисов — минимум 32 символа)
# ─────────────────────────────────────────────────────────────
JWT_SECRET=REPLACE_WITH_STRONG_SECRET_MIN_32_CHARS
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=86400000

# ─────────────────────────────────────────────────────────────
# PostgreSQL (один экземпляр, 4 схемы)
# ─────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=diploma
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ─────────────────────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────────────────────
REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ─────────────────────────────────────────────────────────────
# Kafka
# ─────────────────────────────────────────────────────────────
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_USER_TOPIC=user
KAFKA_UPDATE_SUBSCRIPTION_TOPIC=update-subscription
KAFKA_ROOM_LIFECYCLE_TOPIC=room-lifecycle

# ─────────────────────────────────────────────────────────────
# MinIO (S3-compatible)
# ─────────────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
MINIO_ACCESS_KEY=REPLACE_WITH_ACCESS_KEY
MINIO_SECRET_KEY=REPLACE_WITH_SECRET_KEY
MINIO_REGION=eu-north-1
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_BASE_URL=https://YOUR_DOMAIN/s3

# ─────────────────────────────────────────────────────────────
# Buckets & Folders
# ─────────────────────────────────────────────────────────────
PROFILE_PICTURE_BUCKET=user-profile-picture
PROFILE_PICTURE_FOLDER=user-profile-pictures/

# ─────────────────────────────────────────────────────────────
# gRPC межсервисные адреса
# Для локалки — не задавай (дефолты на localhost из application.yaml)
# Для Docker — указываем имена контейнеров
# ─────────────────────────────────────────────────────────────
GRPC_USER_SERVICE_ADDRESS=static://user-service:7093
GRPC_SECURITY_SERVICE_ADDRESS=static://security-service:7090
GRPC_BANK_SERVICE_ADDRESS=static://bank-service:7094

# ─────────────────────────────────────────────────────────────
# HTTP межсервисные адреса
# ─────────────────────────────────────────────────────────────
# api-gateway routes
USER_SERVICE_URL=http://user-service:8083
SECURITY_SERVICE_URL=http://security-service:8080
GAME_SERVICE_URL=http://game-service:8082
WEBSOCKET_HUB_URL=http://websocket-hub-service:8081
BANK_SERVICE_URL=http://bank-service:8084

# websocket-hub → game-service (HTTP)
# Note: если назвал game-service иначе в compose — подправь
# GAME_SERVICE_URL уже объявлен выше, используется и тут

# ─────────────────────────────────────────────────────────────
# CORS (api-gateway)
# ─────────────────────────────────────────────────────────────
ALLOWED_ORIGINS_URLS=https://YOUR_DOMAIN

# ─────────────────────────────────────────────────────────────
# Безопасность
# ─────────────────────────────────────────────────────────────
# В Docker: false (сетевая изоляция заменяет whitelist)
SERVICE_WHITELIST_ENABLED=false
WS_TICKET_TTL_SECONDS=30

# ─────────────────────────────────────────────────────────────
# Cron расписания
# ─────────────────────────────────────────────────────────────
CRON_CLEANUP_ROOMS=0 0/5 * * * *
CRON_CLEANUP_PENDING_DELETE_ROOMS=0 2/5 * * * *
CRON_UPDATE_USER_SUBSCRIPTIONS=0 0 2 * * *
CRON_CREATE_TRANSACTION_SUMMARIES=0 0 3 1 * *

# ─────────────────────────────────────────────────────────────
# Swagger / Springdoc
# ─────────────────────────────────────────────────────────────
# false на проде, true для альфа-тестирования
SWAGGER_ENABLED=true

# ─────────────────────────────────────────────────────────────
# Logging (INFO для прода, DEBUG для отладки)
# ─────────────────────────────────────────────────────────────
LOG_LEVEL_SPRING_WEB=INFO
LOG_LEVEL_SPRING_SECURITY=INFO
LOG_LEVEL_GATEWAY=INFO
LOG_LEVEL_WEBSOCKET=INFO
LOG_LEVEL_GRPC=INFO

# ─────────────────────────────────────────────────────────────
# Rate limiting (api-gateway)
# ─────────────────────────────────────────────────────────────
RATE_LIMIT_REPLENISH_RATE=10
RATE_LIMIT_BURST_CAPACITY=20
GATEWAY_CONNECT_TIMEOUT=3000
GATEWAY_RESPONSE_TIMEOUT=30s
